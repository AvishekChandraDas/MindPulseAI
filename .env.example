# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Prisma) — configure when adding the database layer
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mindpulse_ai?schema=public

# Auth.js / NextAuth.js v4 — Google OAuth credentials are server-only
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Admin — comma-separated server-side allowlist; never prefix with NEXT_PUBLIC_
# ADMIN_EMAILS=admin@example.com

# Gemini API — server-only. The free tier has rate limits and may use submitted
# content to improve Google products; obtain clear user consent before use.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Resend — configure when adding email
# RESEND_API_KEY=
