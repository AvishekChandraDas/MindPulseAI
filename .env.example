# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (Prisma) — configure when adding the database layer
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mindpulse_ai?schema=public

# Auth.js / NextAuth.js v4 — Google OAuth credentials are server-only
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Admin — comma-separated server-side allowlist; never prefix with NEXT_PUBLIC_
# ADMIN_EMAILS=admin@example.com

# OpenAI — configure when adding AI features
# OPENAI_API_KEY=

# Resend — configure when adding email
# RESEND_API_KEY=
